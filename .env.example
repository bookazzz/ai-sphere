# Copy to backend/.env for local development. Generate a unique production secret:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
AISPHERE_ENVIRONMENT=development
AISPHERE_DEBUG=false
AISPHERE_JWT_SECRET=replace-with-a-new-random-secret-at-least-32-characters
AISPHERE_COOKIE_SECURE=false
AISPHERE_FRONTEND_URL=http://localhost:3000
AISPHERE_CORS_ORIGINS=http://localhost:3000
AISPHERE_DATA_DIR=./data

AISPHERE_OPENROUTER_API_KEY=
AISPHERE_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AISPHERE_OPENROUTER_PROXY=
AISPHERE_WEB_SEARCH_ENABLED=false
AISPHERE_MEDIA_GENERATION_ENABLED=true
AISPHERE_VIDEO_GENERATION_ENABLED=true
AISPHERE_AUTO_ROUTING_ENABLED=true
AISPHERE_MEDIA_RETENTION_DAYS=30
AISPHERE_HISTORY_RETENTION_DAYS=30
AISPHERE_FREE_DAILY_COST_BUDGET_USD=5
AISPHERE_MONTHLY_FIXED_COST_RUB=0
AISPHERE_CREDITS_PER_USD=1200
AISPHERE_OPENROUTER_SMOKE_MAX_USD=2
# News automation uses balanced editorial QA by default. Set NEWS_STRICT_QA=1
# only for temporary audits; warnings do not block normal publication.
NEWS_MODEL_IDS=deepseek/deepseek-v4-flash
AISPHERE_NEWS_PROXY=
NEWS_PROXY_REQUIRED=1
NEWS_STRICT_QA=0
NEWS_MAX_AGE_HOURS=96
NEWS_MIN_GENERATION_SCORE=0.42
NEWS_MIN_PRODUCT_RELEVANCE=0.05
# Conservative pricing guard. The sell price is calculated from the cheapest
# active tariff including bonus credits.
AISPHERE_USD_RUB_RATE=95
AISPHERE_TARGET_GROSS_MARGIN=0.80
AISPHERE_PAYMENT_FEE_RATE=0.05
AISPHERE_FX_SAFETY_FACTOR=1.10
AISPHERE_OPENROUTER_FUNDING_FEE_RATE=0.055
AISPHERE_ANALYTICS_V2_ENABLED=true
AISPHERE_CAMPAIGNS_ENABLED=true
AISPHERE_GAMIFICATION_ENABLED=true
AISPHERE_EXPERIMENTS_ENABLED=true

# Server-side SEO research only. Never expose this as NEXT_PUBLIC_*.
# Rotate any token that has previously been pasted into chat or committed.
KEYSO_API_TOKEN=

AISPHERE_YANDEX_CLIENT_ID=
AISPHERE_YANDEX_CLIENT_SECRET=
AISPHERE_YANDEX_REDIRECT_URI=http://localhost:8000/api/auth/oauth/yandex/callback
AISPHERE_VK_CLIENT_ID=
AISPHERE_VK_CLIENT_SECRET=
AISPHERE_VK_REDIRECT_URI=http://localhost:8000/api/auth/oauth/vk/callback

AISPHERE_PLATEGA_MERCHANT_ID=
AISPHERE_PLATEGA_SECRET_KEY=
AISPHERE_PLATEGA_RETURN_URL=http://localhost:3000/prices?payment=success
AISPHERE_PLATEGA_FAIL_URL=http://localhost:3000/prices?payment=failed
